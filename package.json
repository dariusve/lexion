{
  "name": "lexion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build:apps": "pnpm -r --filter './apps/*' build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tests/tsconfig.json",
    "test:watch": "vitest",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "dev:api": "pnpm --filter @lexion-rte/api build && pnpm --filter @lexion-rte/api start",
    "dev:docs": "pnpm --filter @lexion-rte/docs dev",
    "dev:web-sample": "pnpm --filter @lexion-rte/web-sample dev",
    "dev:react-sample": "pnpm --filter @lexion-rte/react-sample dev",
    "dev:vue-sample": "pnpm --filter @lexion-rte/vue-sample dev",
    "dev:vue2-sample": "pnpm --filter @lexion-rte/vue2-sample dev",
    "dev:angular-sample": "pnpm --filter @lexion-rte/angular-sample dev",
    "dev:svelte-sample": "pnpm --filter @lexion-rte/svelte-sample dev",
    "dev:solid-sample": "pnpm --filter @lexion-rte/solid-sample dev",
    "dev:astro-sample": "pnpm --filter @lexion-rte/astro-sample dev",
    "dev:next-sample": "pnpm --filter @lexion-rte/next-sample dev",
    "dev:nuxt-sample": "pnpm --filter @lexion-rte/nuxt-sample dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.19.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remixicon": "^4.6.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "vue": "^3.4.0"
  }
}
